{
    "name": "@hofjs/hofjs",
    "version": "2.0.0",
    "description": "High Observability Framework",
    "author": "Hof.js contributors",
    "repository": "https://github.com/hofjs/hof",
    "license": "MIT",
    "keywords": [
        "framework",
        "observability"
    ],
    "main": "./lib/cjs/hof.cjs",
    "module": "./lib/esm/hof.js",
    "types": "./lib/esm/hof.d.js",
    "browser": "./lib/nomodule/hof.js",
    "scripts": {
        "start": "vite",
        "build:all":"npm run build && npm run types:manu && npm run gzip",
        
        "build": "vite build",
        
        "types:auto": "npx tsc && echo  !!!warning!!! automatically created Types from lib are not very good, better create manually a hof.d.ts file",
        "types:manu": "cp manuallTypes.d.ts lib/esm/hof.d.ts",
        
        "gzip": "gzip -k lib/esm/hof.js lib/esm/hof.min.js lib/cjs/hof.cjs lib/cjs/hof.min.cjs lib/nomodule/hof.js lib/nomodule/hof.min.js"
        
    },
    "type": "module",
    "devDependencies": {
        "@rollup/plugin-commonjs": "^28.0.3",
        "rollup-plugin-terser": "^7.0.2",
        "typescript": "^5.8.3",
        "vite": "^6.3.2"
    },
    "files": ["lib"]
}